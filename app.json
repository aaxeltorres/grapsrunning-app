{
  "expo": {
    "name": "Graps Running",
    "slug": "grapsrunning-app",
    "version": "1.10.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.grapsrunning.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "location",
          "location",
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Graps Running needs access to your location to track your run.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Graps Running needs access to your location to keep tracking your run even when the app is in the background."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Graps Running to use your location for run tracking.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "owner": "graps-running",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "3330eb25-9140-4b04-bac6-8e3b570b96e7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/3330eb25-9140-4b04-bac6-8e3b570b96e7"
    }
  }
}
